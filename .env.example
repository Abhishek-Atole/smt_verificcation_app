# PostgreSQL
DATABASE_URL=postgresql://smt_user:smt_password@localhost:5432/smt_verification

# API Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-required
JWT_EXPIRY=24h

# Admin IP Allowlist (comma-separated)
ADMIN_IP_ALLOWLIST=127.0.0.1,192.168.1.100

# Session config
SESSION_TIMEOUT_MINUTES=30

# Scan config
SCAN_TIMEOUT_MS=15000
MAX_CONCURRENT_SCANS=20
