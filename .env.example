# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# PostgreSQL Connection String
# Note: Special characters in password must be URL-encoded:
#   @ = %40, # = %23, $ = %24, % = %25, ! = %21
# Default credentials:
#   Username: smt_feeder_verification
#   Password: Abhi@#$%!_170403 (URL-encoded as: Abhi%40%23%24%25%21_170403)
#   Host: localhost
#   Port: 5432
#   Database: smt_verification
DATABASE_URL=postgresql://smt_feeder_verification:Abhi%40%23%24%25%21_170403@localhost:5432/smt_verification

# Database connection pooling
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_POOL_IDLE_MS=30000

# ============================================================
# API SERVER CONFIGURATION
# ============================================================
# API Server
PORT=3000
NODE_ENV=development
API_URL=http://localhost:3000

# JWT
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-required
JWT_ALGORITHM=HS256
JWT_EXPIRY=24h

# Security - IP hash pepper (must be 32+ characters and kept secret)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HASH_PEPPER=replace-this-with-a-random-32-char-string

# Admin IP Allowlist (comma-separated)
ADMIN_IP_ALLOWLIST=127.0.0.1,192.168.1.100

# Session config
SESSION_TIMEOUT_MINUTES=30

# Scan config
SCAN_TIMEOUT_MS=15000
MAX_CONCURRENT_SCANS=20

# Logging configuration (debug|info|warn|error)
LOG_LEVEL=info

# Socket.IO rate limiting (events per second per socket)
SOCKET_RATE_LIMIT=10

# HTTP rate limiting
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
