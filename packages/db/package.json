{
  "name": "@smt/db",
  "version": "0.1.0",
  "description": "Database schema and migrations",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
